# ---- core ----
PORT=3000
APP_BASE_URL=http://localhost:3000
# 32-byte hex key used to encrypt provider tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Google ----
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorised redirect URI: http://localhost:3000/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft ----
# Entra ID > App registrations > your app. Use "common" to allow personal + work accounts.
# Redirect URI (type: Web): http://localhost:3000/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Namespace GUID for the Outlook extended property that carries our event UID.
# Any stable GUID works; keep it constant once events exist.
MICROSOFT_EXT_PROP_GUID=4d87a1c2-0f3e-4a21-9b76-2c5d8e9f1a30

# ---- sync worker ----
SYNC_POLL_MS=750
SYNC_MAX_ATTEMPTS=6
